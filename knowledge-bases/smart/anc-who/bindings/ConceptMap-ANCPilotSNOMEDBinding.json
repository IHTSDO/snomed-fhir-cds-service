  "version": "0.1.0",
  "name": "ANCPilotSNOMEDBinding",
  "title": "SNOMED CT binding of the WHO SMART ANC pilot data elements",
  "status": "draft",
  "experimental": true,
  "date": "2026-11-13",
  "publisher": "SNOMED International (demonstrator)",
  "description": "Curated SNOMED CT codes for the ANC codes used by the six WHO SMART ANC decision tables of the pilot. The CDS service adds them to the ANC value sets, so the unmodified WHO logic also accepts SNOMED CT-coded data. Starts from the WHO ANC -> SNOMED CT ConceptMap (http://smart.who.int/anc/ConceptMap/SNOMED-CT, 0.3.0) and corrects it; see bindings/README.md for the review of each entry.",
  "sourceCanonical": "http://smart.who.int/anc/ValueSet/anc-custom-codes",
  "targetUri": "http://snomed.info/sct",
  "group": [
    {
      "source": "http://smart.who.int/anc/CodeSystem/anc-custom-codes",
      "target": "http://snomed.info/sct",
      "targetVersion": "http://snomed.info/sct/900000000000207008/version/20260701",
      "element": [
        {
          "code": "ANC.B5.DE48",
          "display": "Danger signs",
          "target": [
            {
              "equivalence": "unmatched",
              "comment": "A form question (\"Danger signs\") whose answers are findings. SNOMED CT has no observable for it, and a SNOMED CT-native record would state the finding itself (e.g. Observation.code = central cyanosis). Supporting that needs the CQL data element to change, not a code."
            }
          ]
        },
        {
          "code": "ANC.B6.DE17",
          "display": "Gestational age",
          "target": [
            {
              "code": "57036006",
              "display": "Fetal gestational age (observable entity)",
              "equivalence": "equivalent"
            }
          ]
        },
        {
          "code": "ANC.B6.DE83",
          "display": "Existing chronic health conditions",
          "target": [
            {
              "equivalence": "unmatched",
              "comment": "A form question (\"Existing chronic health conditions\"); in FHIR these are usually Conditions, not Observations."
            }
          ]
        },
        {
          "code": "ANC.B7.DE1",
          "display": "Medication follow-up",
          "target": [
            {
              "equivalence": "unmatched",
              "comment": "Not used by the pilot's decisions."
            }
          ]
        },
        {
          "code": "ANC.B8.DE17",
          "display": "Systolic blood pressure",
          "target": [
            {
              "code": "271649006",
              "display": "Systolic blood pressure (observable entity)",
              "equivalence": "equivalent"
            }
          ]
        },
        {
          "code": "ANC.B8.DE19",
          "display": "Diastolic blood pressure",
          "target": [
            {
              "code": "271650006",
              "display": "Diastolic blood pressure (observable entity)",
              "equivalence": "equivalent"
            }
          ]
        },
        {
          "code": "ANC.B8.DE20",
          "display": "Repeat systolic blood pressure",
          "target": [
            {
              "equivalence": "unmatched",
              "comment": "Same concept as the first systolic reading. SNOMED CT has no concept for a repeat reading. If bound, one reading would count as both the first and the repeat measurement and meet the two-reading criteria of DT17 alone. Needs a data-model decision (e.g. the CQL taking the two earliest readings of one code), not a code."
            }
          ]
        },
        {
          "code": "ANC.B8.DE21",
          "display": "Repeat diastolic blood pressure",
          "target": [
            {
              "equivalence": "unmatched",
              "comment": "As for the repeat systolic reading."
            }
          ]
        },
        {
          "code": "ANC.B8.DE27",
          "display": "Symptoms of severe pre-eclampsia",
          "target": [
            {
              "equivalence": "unmatched",
              "comment": "A form question, as \"Danger signs\"."
            }
          ]
        },
        {
